# PyMotion Lite ESP32-S3 native USB Serial/JTAG.
# Keep access limited to the normal serial group/current desktop user; never 0666.
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", ATTRS{manufacturer}=="Espressif", ATTRS{product}=="USB JTAG/serial debug unit", GROUP="dialout", MODE="0660", TAG+="uaccess", ENV{ID_MM_DEVICE_IGNORE}="1"
